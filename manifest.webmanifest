    { "src": "img/app-icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "img/app-icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "img/app-icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Timetable", "url": "./timetable.html", "icons": [{ "src": "img/app-icon-192.png", "sizes": "192x192" }] },
    { "name": "Exams", "url": "./exams.html", "icons": [{ "src": "img/app-icon-192.png", "sizes": "192x192" }] },
    { "name": "Notes & Resources", "url": "./notes.html", "icons": [{ "src": "img/app-icon-192.png", "sizes": "192x192" }] }
  ]
}
