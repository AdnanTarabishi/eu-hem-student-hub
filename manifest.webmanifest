  "description": "Unofficial student-run hub for the EU-HEM master's program: timetable, exams, study plan, notes and city guide.",
  "id": "./",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f7f5f1",
  "theme_color": "#0f2b5b",
